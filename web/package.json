{
  "name": "codex-speed-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --kill-signal SIGINT --kill-timeout 5000 --names rust,vite \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "build": "tsc -b && vite build",
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "playwright test",
    "dev:frontend": "vite",
    "dev:backend": "watchexec --restart --stop-signal SIGINT --stop-timeout 5s --debounce 300ms --watch ../src --watch ../Cargo.toml --watch ../Cargo.lock --watch ../build.rs -- cargo run --manifest-path ../Cargo.toml --target-dir ../target/dev-build --no-default-features --locked -- --port 4319 --data-dir ../target/dev-data",
    "build:release": "pnpm build && cargo build --manifest-path ../Cargo.toml --release --locked"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
